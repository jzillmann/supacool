+test "RepeatableLink: parse" {
+    const testing = std.testing;
+    var arena = ArenaAllocator.init(testing.allocator);
+    defer arena.deinit();
+    const alloc = arena.allocator();
+
+    var list: RepeatableLink = .{};
+    try list.parseCLI(alloc, "\\bCEN-\\d+\\b,open");
+    try testing.expectEqual(@as(usize, 1), list.links.items.len);
+    try testing.expectEqualStrings("\\bCEN-\\d+\\b", list.links.items[0].regex);
+    try testing.expect(list.links.items[0].action == .open);
+    try testing.expect(list.links.items[0].highlight == .hover_mods);
+
+    // A comma inside the regex belongs to the regex.
+    try list.parseCLI(alloc, "\\b[A-Z]{2,6}-\\d+\\b,open,always");
+    try testing.expectEqual(@as(usize, 2), list.links.items.len);
+    try testing.expectEqualStrings("\\b[A-Z]{2,6}-\\d+\\b", list.links.items[1].regex);
+    try testing.expect(list.links.items[1].highlight == .always);
+
+    // The exact shape Supacool emits for ticket ids.
+    try list.parseCLI(alloc, "\\b(CEN|FOO)-\\d+\\b,open,hover-mods:super");
+    try testing.expectEqualStrings("\\b(CEN|FOO)-\\d+\\b", list.links.items[2].regex);
+    try testing.expect(list.links.items[2].highlight.hover_mods.super);
+
+    try list.parseCLI(alloc, "foo,open,hover-mods:ctrl+shift");
+    try testing.expect(list.links.items[3].highlight.hover_mods.ctrl);
+    try testing.expect(list.links.items[3].highlight.hover_mods.shift);
+
+    // Empty resets.
+    try list.parseCLI(alloc, "");
+    try testing.expectEqual(@as(usize, 0), list.links.items.len);
+}
