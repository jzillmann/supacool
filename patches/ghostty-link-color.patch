 };
 
+/// A list of `link-color` rules: text matching `regex` is drawn in `color`.
+pub const RepeatableLinkColor = struct {
+    const Self = @This();
+
+    pub const Entry = struct {
+        regex: []const u8,
+        color: Color,
+    };
+
+    items: std.ArrayList(Entry) = .empty,
+
+    /// Syntax: `link-color = <regex>,<color>`. Parsed right-to-left so the
+    /// regex may contain commas. An empty value resets the list.
+    pub fn parseCLI(self: *Self, alloc: Allocator, input_: ?[]const u8) !void {
+        const input = input_ orelse "";
+        if (input.len == 0) {
+            self.items.clearRetainingCapacity();
+            return;
+        }
+
+        const idx = std.mem.lastIndexOfScalar(u8, input, ',') orelse
+            return error.InvalidValue;
+        const regex = input[0..idx];
+        if (regex.len == 0) return error.InvalidValue;
+        const color = Color.parseCLI(input[idx + 1 ..]) catch
+            return error.InvalidValue;
+
+        // Reject a regex oniguruma can't compile at config-parse time,
+        // rather than logging a failure on every frame.
+        {
+            const probe: inputpkg.Link = .{
+                .regex = regex,
+                .action = .{ .open = {} },
+                .highlight = .{ .always = {} },
+            };
+            var compiled = probe.oniRegex() catch return error.InvalidValue;
+            compiled.deinit();
+        }
+
+        try self.items.append(alloc, .{
+            .regex = try alloc.dupe(u8, regex),
+            .color = color,
+        });
+    }
+
+    /// Deep copy of the struct. Required by Config.
+    pub fn clone(
+        self: *const Self,
+        alloc: Allocator,
+    ) Allocator.Error!Self {
+        var list = try std.ArrayList(Entry).initCapacity(
+            alloc,
+            self.items.items.len,
+        );
+        for (self.items.items) |item| {
+            list.appendAssumeCapacity(.{
+                .regex = try alloc.dupe(u8, item.regex),
+                .color = item.color,
+            });
+        }
+        return .{ .items = list };
+    }
+
+    /// Compare if two of our value are requal. Required by Config.
+    pub fn equal(self: Self, other: Self) bool {
+        const itemsA = self.items.items;
+        const itemsB = other.items.items;
+        if (itemsA.len != itemsB.len) return false;
+        for (itemsA, itemsB) |a, b| {
+            if (!a.color.equal(b.color)) return false;
+            if (!std.mem.eql(u8, a.regex, b.regex)) return false;
+        } else return true;
+    }
+
+    /// Used by Formatter
+    pub fn formatEntry(self: Self, formatter: formatterpkg.EntryFormatter) !void {
+        var buf: [4096]u8 = undefined;
+        for (self.items.items) |item| {
+            const value = std.fmt.bufPrint(
+                &buf,
+                "{s},#{x:0>2}{x:0>2}{x:0>2}",
+                .{ item.regex, item.color.r, item.color.g, item.color.b },
+            ) catch continue;
+            try formatter.formatEntry([]const u8, value);
+        }
+    }
+
+    test "parseCLI" {
+        const testing = std.testing;
+        var arena = ArenaAllocator.init(testing.allocator);
+        defer arena.deinit();
+        const alloc = arena.allocator();
+
+        var list: Self = .{};
+        try list.parseCLI(alloc, "\\b(CEN-1|CEN-2)\\b,#30d158");
+        try testing.expectEqual(@as(usize, 1), list.items.items.len);
+        try testing.expectEqualStrings("\\b(CEN-1|CEN-2)\\b", list.items.items[0].regex);
+        try testing.expectEqual(@as(u8, 0x30), list.items.items[0].color.r);
+        try testing.expectEqual(@as(u8, 0xd1), list.items.items[0].color.g);
+
+        // A comma inside the regex belongs to the regex.
+        try list.parseCLI(alloc, "a{1,2},#ffffff");
+        try testing.expectEqualStrings("a{1,2}", list.items.items[1].regex);
+
+        try testing.expectError(error.InvalidValue, list.parseCLI(alloc, "foo"));
+        try testing.expectError(error.InvalidValue, list.parseCLI(alloc, ",#ffffff"));
+        try testing.expectError(error.InvalidValue, list.parseCLI(alloc, "foo,notacolor"));
+        try testing.expectError(error.InvalidValue, list.parseCLI(alloc, "[bad,#ffffff"));
+
+        // Empty resets.
+        try list.parseCLI(alloc, "");
+        try testing.expectEqual(@as(usize, 0), list.items.items.len);
+    }
+
+    test "formatEntry" {
+        const testing = std.testing;
+        var arena = ArenaAllocator.init(testing.allocator);
+        defer arena.deinit();
+        const alloc = arena.allocator();
+
+        var buf: std.Io.Writer.Allocating = .init(alloc);
+        defer buf.deinit();
+
+        var list: Self = .{};
+        try list.parseCLI(alloc, "CEN-1,#30d158");
+        try list.formatEntry(formatterpkg.entryFormatter("link-color", &buf.writer));
+        try testing.expectEqualStrings("link-color = CEN-1,#30d158\n", buf.written());
+    }
+};
