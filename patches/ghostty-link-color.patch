+/// Cells to recolor, mapped to their foreground color.
+pub const ColorMap = std.AutoHashMapUnmanaged(point.Coordinate, terminal.color.RGB);
+
+/// A set of `link-color` rules: regexes whose matches are drawn in a
+/// fixed foreground color. Unlike `Set` these are purely visual and
+/// always active, independent of mouse and modifier state.
+pub const ColorSet = struct {
+    pub const Rule = struct {
+        regex: oni.Regex,
+        color: terminal.color.RGB,
+    };
+
+    rules: []Rule,
+
+    pub const Entry = struct {
+        regex: []const u8,
+        color: terminal.color.RGB,
+    };
+
+    pub fn init(alloc: Allocator, entries: []const Entry) !ColorSet {
+        var rules: std.ArrayList(Rule) = .empty;
+        defer rules.deinit(alloc);
+        errdefer for (rules.items) |*rule| rule.regex.deinit();
+
+        for (entries) |entry| {
+            var regex = try oni.Regex.init(
+                entry.regex,
+                .{},
+                oni.Encoding.utf8,
+                oni.Syntax.default,
+                null,
+            );
+            errdefer regex.deinit();
+            try rules.append(alloc, .{ .regex = regex, .color = entry.color });
+        }
+
+        return .{ .rules = try rules.toOwnedSlice(alloc) };
+    }
+
+    pub fn deinit(self: *ColorSet, alloc: Allocator) void {
+        for (self.rules) |*rule| rule.regex.deinit();
+        alloc.free(self.rules);
+    }
+
+    /// Fills `result` with the color of every cell some rule matches. The
+    /// first rule to claim a cell wins. `alloc` is used for `result` and
+    /// for scratch buffers, so pass an allocator that outlives `result`.
+    pub fn renderColorMap(
+        self: *const ColorSet,
+        alloc: Allocator,
+        result: *ColorMap,
+        render_state: *const terminal.RenderState,
+    ) !void {
+        if (self.rules.len == 0) return;
+
+        var builder: std.Io.Writer.Allocating = .init(alloc);
+        defer builder.deinit();
+        var map: terminal.RenderState.StringMap = .empty;
+        defer map.deinit(alloc);
+        try render_state.string(&builder.writer, .{
+            .alloc = alloc,
+            .map = &map,
+        });
+
+        const str = builder.writer.buffered();
+
+        for (self.rules) |*rule| {
+            var offset: usize = 0;
+            while (offset < str.len) {
+                var region = rule.regex.search(
+                    str[offset..],
+                    .{},
+                ) catch |err| switch (err) {
+                    error.Mismatch => break,
+                    else => return err,
+                };
+                defer region.deinit();
+
+                const start = offset + @as(usize, @intCast(region.starts()[0]));
+                const end = offset + @as(usize, @intCast(region.ends()[0]));
+
+                // An empty match would never advance; skip one byte.
+                if (end == start) {
+                    offset = end + 1;
+                    continue;
+                }
+                offset = end;
+
+                for (map.items[start..end]) |pt| {
+                    const gop = try result.getOrPut(alloc, pt);
+                    if (!gop.found_existing) gop.value_ptr.* = rule.color;
+                }
+            }
+        }
+    }
+};
+
+test "renderColorMap" {
+    const testing = std.testing;
+    const alloc = testing.allocator;
+
+    var t: terminal.Terminal = try .init(testing.io, alloc, .{
+        .cols = 5,
+        .rows = 3,
+    });
+    defer t.deinit(alloc);
+
+    var s = t.vtStream();
+    defer s.deinit();
+    s.nextSlice("1ABCD2EFGH\r\n3IJKL");
+
+    var state: terminal.RenderState = .empty;
+    defer state.deinit(alloc);
+    try state.update(alloc, &t);
+
+    const green: terminal.color.RGB = .{ .r = 0, .g = 255, .b = 0 };
+    const red: terminal.color.RGB = .{ .r = 255, .g = 0, .b = 0 };
+    var set = try ColorSet.init(alloc, &.{
+        .{ .regex = "AB", .color = green },
+        .{ .regex = "BC|IJ", .color = red },
+    });
+    defer set.deinit(alloc);
+
+    var result: ColorMap = .empty;
+    defer result.deinit(alloc);
+    try set.renderColorMap(alloc, &result, &state);
+
+    try testing.expect(result.get(.{ .x = 0, .y = 0 }) == null);
+    try testing.expectEqual(green, result.get(.{ .x = 1, .y = 0 }).?);
+    // First rule wins on overlap.
+    try testing.expectEqual(green, result.get(.{ .x = 2, .y = 0 }).?);
+    try testing.expectEqual(red, result.get(.{ .x = 3, .y = 0 }).?);
+    try testing.expectEqual(red, result.get(.{ .x = 1, .y = 2 }).?);
+    try testing.expect(result.get(.{ .x = 4, .y = 1 }) == null);
+}
+
+test "renderColorMap Supacool rule shapes" {
+    const testing = std.testing;
+    const alloc = testing.allocator;
+
+    var t: terminal.Terminal = try .init(testing.io, alloc, .{
+        .cols = 60,
+        .rows = 2,
+    });
+    defer t.deinit(alloc);
+
+    var s = t.vtStream();
+    defer s.deinit();
+    s.nextSlice("CEN-12 rocket#5 x/acme/rocket#5\r\nAcme/Rocket#9 CEN-123");
+
+    var state: terminal.RenderState = .empty;
+    defer state.deinit(alloc);
+    try state.update(alloc, &t);
+
+    const green: terminal.color.RGB = .{ .r = 0, .g = 255, .b = 0 };
+    const red: terminal.color.RGB = .{ .r = 255, .g = 0, .b = 0 };
+    var set = try ColorSet.init(alloc, &.{
+        .{ .regex = "\\b(?:CEN-(?:12))\\b", .color = red },
+        .{
+            .regex = "(?i)(?:(?:(?<![\\w./-])(?:acme/)?rocket#|github\\.com/acme/rocket/pull/)(?:5|9))\\b",
+            .color = green,
+        },
+    });
+    defer set.deinit(alloc);
+
+    var result: ColorMap = .empty;
+    defer result.deinit(alloc);
+    try set.renderColorMap(alloc, &result, &state);
+
+    // CEN-12 colored, CEN-123 not.
+    try testing.expectEqual(red, result.get(.{ .x = 0, .y = 0 }).?);
+    try testing.expect(result.get(.{ .x = 14, .y = 1 }) == null);
+    // Bare repo#N colored.
+    try testing.expectEqual(green, result.get(.{ .x = 7, .y = 0 }).?);
+    // Inside a longer path: not colored.
+    try testing.expect(result.get(.{ .x = 18, .y = 0 }) == null);
+    try testing.expect(result.get(.{ .x = 24, .y = 0 }) == null);
+    // owner/repo#N, case-insensitive.
+    try testing.expectEqual(green, result.get(.{ .x = 0, .y = 1 }).?);
+}
